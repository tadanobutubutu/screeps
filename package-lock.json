#!/usr/bin/env bash
# Resolve merge conflicts in package-lock.json by selecting the HEAD version.

INPUT="package-lock.json"
OUTPUT="package-lock.json.resolved"

awk '
/^<<<<<<< / { in_conflict=1; next }          # Skip the start marker
/^>>>>>>> / { in_conflict=0; next }          # Skip the end marker
in_conflict==1 && /^=======$ / { next }      # Skip the separator
{ print }                                   # Print non‑conflict lines
' "$INPUT" > "$OUTPUT"

mv "$OUTPUT" "$INPUT"
