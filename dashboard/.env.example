# Screeps APIトークン（Vercelの環境変数に設定する）
SCREEPS_TOKEN=your_token_here
# Screepsユーザー名
SCREEPS_USERNAME=your_username_here
# ダッシュボード認証用のシークレットキー（任意の設定）
DASHBOARD_SECRET=your_dashboard_secret_here
# クローンジョブ起動用のシークレットキー（任意の設定）
CRON_SECRET=your_cron_secret_here
# SupabaseプロジェクトのURL（統計情報の保存用）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# Supabaseサービスロールキー（統計情報の保存用）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
