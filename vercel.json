{
  "buildCommand": "cd dashboard && npm run build",
  "outputDirectory": "dashboard/out",
  "installCommand": "cd dashboard && npm install",
  "framework": "nextjs",
  "github": {
    "enabled": true,
    "autoJobCancelation": true,
    "deploymentEnabled": {
      "production": true,
      "preview": true,
      "branch": "main"
    }
  },
  "git": {
    "productionBranch": "main"
  }
}
