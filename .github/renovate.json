{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays"
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "schedule": ["before 5am on monday"]
    },
    {
      "matchPackageNames": ["dotenv"],
      "schedule": ["before 5am on monday"]
    },
    {
      "matchPackageNames": ["google/osv-scanner-action"],
      "schedule": ["before 5am on monday"]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "npm": {
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "hostRules": [
    {
      "hostType": "npm",
      "baseUrl": "https://registry.npmjs.org",
      "timeout": 60000
    }
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 4,
  "platformCommit": false,
  "gitIgnoredAuthors": [],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.git/**"
  ],
  "postUpgradeTasks": {
    "commands": ["npm ci"],
    "executionMode": "use-isolated-workspace"
  }
}
