{
    "name": "screeps-ai",
    "version": "1.0.0",
    "type": "commonjs",
    "description": "Screeps AI with automated GitHub workflows",
    "main": "main.js",
    "scripts": {
        "build": "rollup -c rollup.config.mjs",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "lint": "eslint . --fix",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tadanobutubutu/screeps.git"
    },
    "keywords": [
        "screeps",
        "ai",
        "game",
        "automation"
    ],
    "author": "tadanobutubutu",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/tadanobutubutu/screeps/issues"
    },
    "homepage": "https://github.com/tadanobutubutu/screeps#readme",
    "dependencies": {
        "@sentry/browser": "^10.54.0",
        "@supabase/supabase-js": "^2.106.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "lodash": "^4.18.1",
        "posthog-js": "^1.376.0"
    },
    "devDependencies": {
        "@codecov/rollup-plugin": "^2.0.1",
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@sentry/rollup-plugin": "^5.3.0",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^10.4.0",
        "eslint-plugin-jest": "^29.15.2",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "jest": "^30.4.2",
        "jest-junit": "^17.0.0",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "rollup": "^4.60.4"
    },
    "overrides": {
        "undici": ">=6.24.0",
        "tmp": ">=0.2.4",
        "commitizen": {
            "lodash": ">=4.18.1"
        },
        "cz-conventional-changelog": {
            "lodash": ">=4.18.1"
        }
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
